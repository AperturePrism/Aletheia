{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AperturePrism/aleth/schemas/roe.schema.json",
  "title": "Aletheia Rules of Engagement (ROE) / Scope Definition",
  "description": "授权与交战规则的机器可校验定义。对应文档 docs/08-授权与交战规则规范.md。注意：本 Schema 只校验结构与字面约束；运行期语义（排除项优先于包含项、默认拒绝、时间窗执行期校验、dos/destructive 硬编码保护）由 Scope Kernel 实现，不在 Schema 表达范围内。",
  "type": "object",
  "required": ["version", "authorization", "targets"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Schema 版本，当前仅支持 1。",
      "const": 1
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "targets": {
      "$ref": "#/$defs/targets"
    },
    "actions": {
      "$ref": "#/$defs/actions"
    },
    "data_handling": {
      "$ref": "#/$defs/dataHandling"
    }
  },
  "$defs": {
    "authorization": {
      "type": "object",
      "description": "授权凭证。Scope Kernel 在进程启动最早期校验，任一必填项缺失或过期即拒绝启动（退出码 3）。",
      "required": ["granted_by", "granted_to", "contact", "valid_from", "valid_until"],
      "additionalProperties": false,
      "anyOf": [
        { "required": ["ticket_id"] },
        { "required": ["document_hash"] }
      ],
      "properties": {
        "granted_by": {
          "description": "授权方名称（必填）。",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "granted_to": {
          "description": "被授权方（必填）。",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contact": {
          "description": "授权方安全联系人，用于事件通知（必填）。",
          "type": "string",
          "format": "email",
          "maxLength": 256
        },
        "ticket_id": {
          "description": "工单号。与 document_hash 至少提供一个。",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "document_hash": {
          "description": "授权书文件哈希（sha256）。与 ticket_id 至少提供一个。",
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "document_path": {
          "description": "授权书原件路径。仅本地使用：不写入日志、不进入模型上下文、不上传，仅记录其哈希。",
          "type": "string",
          "maxLength": 4096
        },
        "valid_from": {
          "description": "授权生效时间（RFC 3339）。",
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "description": "授权失效时间（RFC 3339）。实现须校验 valid_until > valid_from，且跨度不超过 90 天（超长授权需在 PR 中说明理由）。跨度上限无法在 JSON Schema 内表达，由 Scope Kernel 强制。",
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "targets": {
      "type": "object",
      "description": "目标范围。匹配语义（运行期）：exclude 优先于 include；均未命中时默认拒绝。",
      "required": ["include"],
      "additionalProperties": false,
      "properties": {
        "include": {
          "description": "允许的目标，至少一项。",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/targetSelector" }
        },
        "exclude": {
          "description": "明确排除的目标。排除项永远优先于包含项。",
          "type": "array",
          "items": { "$ref": "#/$defs/targetSelector" },
          "default": []
        }
      }
    },
    "targetSelector": {
      "description": "单个目标选择器，三种形式互斥（cidr / host / url_prefix 只能出现一个）。",
      "oneOf": [
        {
          "type": "object",
          "required": ["cidr"],
          "additionalProperties": false,
          "properties": {
            "cidr": {
              "description": "CIDR 网段，如 10.40.23.0/24。",
              "type": "string",
              "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^([0-9a-fA-F:]+)/[0-9]{1,3}$"
            },
            "ports": { "$ref": "#/$defs/portList" }
          }
        },
        {
          "type": "object",
          "required": ["host"],
          "additionalProperties": false,
          "properties": {
            "host": {
              "description": "主机名或单个 IP。",
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "ports": { "$ref": "#/$defs/portList" }
          }
        },
        {
          "type": "object",
          "required": ["url_prefix"],
          "additionalProperties": false,
          "properties": {
            "url_prefix": {
              "description": "URL 前缀，如 https://api.example.com/v2/ 。",
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            }
          }
        }
      ]
    },
    "portList": {
      "type": "array",
      "description": "端口列表。省略表示全部端口。",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "actions": {
      "type": "object",
      "description": "允许/禁止的动作与执行限制。allow 为白名单：未列出的动作默认禁止。",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "description": "允许的动作白名单。",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/actionName" },
          "uniqueItems": true
        },
        "deny": {
          "description": "显式禁止的动作。用于增强审计可读性。注意：dos 与 destructive 由 Scope Kernel 硬编码保护，无论本字段与 allow 如何配置均不可执行。",
          "type": "array",
          "items": { "$ref": "#/$defs/actionName" },
          "uniqueItems": true,
          "default": []
        },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "actionName": {
      "description": "动作类型。前七项为可授权动作；后七项为默认禁止的高风险动作（需显式授权，部分永久不可授权）。",
      "type": "string",
      "enum": [
        "recon",
        "scan",
        "fuzz",
        "exploit",
        "post_exploit",
        "enumerate",
        "persistent_backdoor",
        "dos",
        "destructive",
        "ransomware_sim",
        "social_engineering",
        "physical",
        "supply_chain",
        "data_exfiltration"
      ]
    },
    "limits": {
      "type": "object",
      "description": "执行限制。时间窗（allowed_hours / allowed_days）在执行期校验，不是启动期校验一次。",
      "additionalProperties": false,
      "properties": {
        "max_requests_per_second": {
          "description": "单目标速率上限（请求/秒）。",
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "max_concurrent_tasks": {
          "description": "并发任务上限。",
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 3
        },
        "max_depth_hops": {
          "description": "内网横向最大跳数。",
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 3
        },
        "forbidden_payloads": {
          "description": "内容级载荷黑名单标签，由载荷分类器匹配。",
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["destructive", "persistent_backdoor", "ransomware", "wiper"]
          },
          "uniqueItems": true,
          "default": ["destructive"]
        },
        "allowed_hours": {
          "description": "允许执行的时间窗，格式 HH:MM-HH:MM <IANA 时区>，如 09:00-18:00 Asia/Shanghai。",
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9] [A-Za-z]+(/[A-Za-z_+-]+)*$"
        },
        "allowed_days": {
          "description": "允许执行的星期（RFC 5545 缩写）。",
          "type": "array",
          "items": { "enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"] },
          "uniqueItems": true
        }
      }
    },
    "dataHandling": {
      "type": "object",
      "description": "数据处理要求。no_external_transmission 为 true 时，须配合本地模型运行（不调用外部模型 API）。",
      "additionalProperties": false,
      "properties": {
        "pii_handling": {
          "description": "个人信息的处理方式。mask 表示经 Privacy Gateway 脱敏；allow 表示允许原样处理（需额外授权说明）。",
          "type": "string",
          "enum": ["mask", "allow"],
          "default": "mask"
        },
        "retention_days": {
          "description": "数据与审计日志保留天数。",
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "default": 90
        },
        "no_external_transmission": {
          "description": "是否禁止向外部服务传输任何目标相关数据。为 true 时模型调用必须走本地部署。",
          "type": "boolean",
          "default": true
        },
        "evidence_export_allowed": {
          "description": "证据包允许导出的范围。",
          "type": "array",
          "items": { "enum": ["client", "internal", "public"] },
          "uniqueItems": true,
          "default": ["client"]
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "authorization": {
        "granted_by": "广西某科技有限公司",
        "granted_to": "AperturePrism 团队 / Binbim",
        "contact": "security@example.com",
        "ticket_id": "SEC-2026-0912",
        "document_hash": "sha256:7f3a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8",
        "valid_from": "2026-09-24T00:00:00+08:00",
        "valid_until": "2026-10-24T00:00:00+08:00"
      },
      "targets": {
        "include": [
          { "cidr": "10.40.23.0/24" },
          { "host": "app.example.com", "ports": [80, 443, 8080] },
          { "url_prefix": "https://api.example.com/v2/" }
        ],
        "exclude": [
          { "cidr": "10.40.23.128/25" },
          { "host": "pay.example.com" }
        ]
      },
      "actions": {
        "allow": ["recon", "scan", "fuzz", "exploit", "post_exploit", "enumerate"],
        "deny": ["dos", "destructive", "ransomware_sim", "social_engineering", "physical", "supply_chain", "data_exfiltration"],
        "limits": {
          "max_requests_per_second": 10,
          "max_concurrent_tasks": 3,
          "max_depth_hops": 3,
          "forbidden_payloads": ["destructive", "persistent_backdoor"],
          "allowed_hours": "09:00-18:00 Asia/Shanghai",
          "allowed_days": ["MO", "TU", "WE", "TH", "FR"]
        }
      },
      "data_handling": {
        "pii_handling": "mask",
        "retention_days": 90,
        "no_external_transmission": true,
        "evidence_export_allowed": ["client"]
      }
    }
  ]
}
